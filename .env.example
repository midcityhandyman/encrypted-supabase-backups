# Example configuration. Every value here is fake. Copy to a file readable only
# by the backup user and point BACKUP_ENV_FILE (or systemd EnvironmentFile) at it.
# Keep the database password out of this file: use ~/.pgpass or PGPASSFILE.

# Database to back up. For Supabase use the direct connection or the session
# pooler (port 5432); pg_dump does not work through the transaction pooler.
SOURCE_DATABASE_URL=postgres://backup_reader@db.example.com:5432/postgres?sslmode=require

# age PUBLIC key. This is all the backup step needs; it cannot decrypt.
AGE_RECIPIENT=age1examplepublickeyreplacewithyourownxxxxxxxxxxxxxxxxxxxxxxxxx

# Where encrypted dumps and their sidecars are written.
BACKUP_DIR=/var/backups/postgres

# Restore test: a Postgres you control where a scratch database can be created
# and dropped, and the age PRIVATE key file used to decrypt.
SCRATCH_ADMIN_URL=postgres://restore_tester@localhost:5432/postgres
AGE_IDENTITY_FILE=/etc/encrypted-backups/age-identity.txt

# Optional settings, shown with their defaults.
#BACKUP_PREFIX=db
#BACKUP_SCHEMAS=public
#BACKUP_MIN_BYTES=64
#KEEP_DAILY=7
#KEEP_WEEKLY=4
#SCRATCH_DB_NAME=restore_test_scratch
#ROW_COUNT_TOLERANCE=0
#KEEP_SCRATCH_DB=0
#PRUNE_DRY_RUN=0
